
# --- Telephony -------------------------------------------------------------
# simulated (default) rings the voice web app — no account, no cost, and the
# whole pipeline after "hello" is the real one. twilio places real PSTN calls.
TELEPHONY_PROVIDER=simulated

# Caller ID. Must sit in 555-0100..555-0199, the range NANP reserves as
# fictitious, unless TELEPHONY_ALLOW_REAL_NUMBERS=true.
TELEPHONY_FROM=+16175550100

# Dialling anything outside the fictitious range is refused unless this is
# 'true'. Leave it unset. It exists so that reaching a real telephone is a
# deliberate act rather than a typo in a seed script.
# TELEPHONY_ALLOW_REAL_NUMBERS=true

# Real calls (all three required, plus PUBLIC_HOST for the media stream):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# PUBLIC_HOST=your-tunnel.ngrok-free.app
